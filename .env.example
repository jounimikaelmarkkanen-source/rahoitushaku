# Local quickstart; do not commit real secrets.
FUNDING_DATABASE_URL=sqlite:///data/funding.db
FUNDING_AUTH_MODE=local
FUNDING_SOURCE_FILE=config/sources.json
FUNDING_USER_AGENT=MunicipalFundingRegistry/0.4 (public funding monitoring; contact: SET-ORGANISATION-CONTACT)

