  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReviewInput": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version",
            "description": "Current review version; zero for a new review"
          },
          "source_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Source Version",
            "description": "Opportunity version the reviewer actually read"
          },
          "eligibility": {
            "type": "string",
            "enum": [
              "unreviewed",
              "eligible",
              "conditional",
              "ineligible"
            ],
            "title": "Eligibility"
          },
          "city_role": {
            "type": "string",
            "enum": [
              "unknown",
              "lead",
              "partner",
              "beneficiary"
            ],
            "title": "City Role",
            "default": "unknown"
          },
          "service_area": {
            "type": "string",
            "maxLength": 200,
            "title": "Service Area",
            "default": ""
          },
          "notes": {
            "type": "string",
            "maxLength": 20000,
            "title": "Notes",
            "default": ""
          },
          "evidence_url": {
            "type": "string",
            "maxLength": 2048,
            "title": "Evidence Url",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "expected_version",
          "source_version",
          "eligibility"
        ],
        "title": "ReviewInput"
      },
      "ValidationError": {
        "properties": {
